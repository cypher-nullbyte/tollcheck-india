      "find_link_on_page": "NH-Fee-Plaza",
      "fetch": "auto",
      "file": "ihmcl-nh-fee-plazas-latest.pdf",
      "parse": "scripts/parse_ihmcl.py",
      "output": "ihmcl_nh_fee_plazas_latest.csv",
      "current_copy": {
        "file": "ihmcl-nh-fee-plazas-2026-07.pdf",
        "url": "https://ihmcl.co.in/wp-content/uploads/2026/07/NH-Fee-Plazas-5.pdf"
      }
    },
    {
      "id": "ihmcl_nh_2025_08",
      "name": "IHMCL NH Fee Plazas (Aug 2025, history)",
